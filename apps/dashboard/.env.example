# Copy to .env.production before `pnpm deploy:dashboard`.
# Leave both empty in local dev: the Vite proxy forwards /api to wrangler dev.

# Deployed API Worker
PUBLIC_API_BASE=https://instagram-widget-api.YOUR_SUBDOMAIN.workers.dev

# Deployed widget (Cloudflare Pages project "alfsight-widget")
PUBLIC_WIDGET_URL=https://alfsight-widget.pages.dev
