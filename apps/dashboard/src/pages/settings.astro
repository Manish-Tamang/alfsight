---
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import { buttonClass } from "@/components/ui/Button";
import { control } from "@/components/ui/Field";
---

<DashboardLayout title="Settings | Alfsight">
  <div class="mx-auto w-full max-w-[640px]">
    <h1 class="page-title text-2xl sm:text-[28px]">Settings</h1>
    <p class="mt-1 text-sm text-neutral-500">Workspace preferences.</p>

    <div class="mt-6 overflow-hidden rounded-2xl bg-white shadow-sm shadow-black/5 ring-1 ring-black/5">
      <div class="space-y-5 p-5 sm:p-6">
        <div>
          <h2 class="text-base font-semibold text-neutral-900">General</h2>
          <p class="mt-0.5 text-sm text-neutral-500">How you appear across the dashboard.</p>
        </div>
        <div>
          <label for="display-name" class="mb-1.5 block text-sm font-medium text-neutral-700">Display name</label>
          <input id="display-name" type="text" value="Alfsight User" class:list={[control, "h-9"]} />
        </div>
        <div>
          <label for="email" class="mb-1.5 block text-sm font-medium text-neutral-700">Email</label>
          <input id="email" type="email" value="dev@alfsight.local" class:list={[control, "h-9"]} />
        </div>
      </div>
      <div class="flex items-center justify-between border-t border-neutral-200 bg-neutral-50 px-5 py-3 sm:px-6">
        <p class="text-sm text-neutral-500">Settings are stored locally in development.</p>
        <button type="button" class={buttonClass("primary", "sm")}>Save changes</button>
      </div>
    </div>
  </div>
</DashboardLayout>
