---
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import PageHeader from "@/components/layout/PageHeader.astro";
import Card from "@/components/ui/Card.astro";
---

<DashboardLayout title="Settings — Alfsight">
  <PageHeader
    eyebrow="Workspace"
    title="Settings"
    description="Account preferences and workspace options."
  />

  <div class="grid gap-5 lg:grid-cols-[1fr_320px]">
    <Card>
      <h2 class="text-[14px] font-semibold text-[var(--color-text)]">Profile</h2>
      <p class="mt-1 text-[12.5px] text-[var(--color-text-muted)]">
        Signed in as <code class="font-mono text-[12px]">dev-user-1</code>
      </p>

      <div class="mt-6 space-y-4">
        <div>
          <label class="mb-1.5 block text-[11.5px] font-medium uppercase tracking-[0.1em] text-[var(--color-text-muted)]">
            Display name
          </label>
          <input
            type="text"
            value="Alfsight User"
            class="h-10 w-full rounded-[var(--radius-md)] border border-[var(--color-border)] bg-[var(--color-surface)] px-3.5 text-[13px] outline-none focus:border-[var(--color-primary)]"
          />
        </div>
        <div>
          <label class="mb-1.5 block text-[11.5px] font-medium uppercase tracking-[0.1em] text-[var(--color-text-muted)]">
            Email
          </label>
          <input
            type="email"
            value="dev@alfsight.local"
            class="h-10 w-full rounded-[var(--radius-md)] border border-[var(--color-border)] bg-[var(--color-surface)] px-3.5 text-[13px] outline-none focus:border-[var(--color-primary)]"
          />
        </div>
      </div>
    </Card>

    <Card>
      <h2 class="text-[14px] font-semibold text-[var(--color-text)]">Plan</h2>
      <p class="mt-1 text-[12.5px] text-[var(--color-text-muted)]">
        You are on the free development plan.
      </p>
      <div class="mt-4 rounded-[var(--radius-lg)] bg-[var(--color-surface-2)] p-4 text-[12.5px] text-[var(--color-text-muted)]">
        Unlimited widgets, 10k monthly views.
      </div>
    </Card>
  </div>
</DashboardLayout>
