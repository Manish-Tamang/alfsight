---
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import { WidgetsGrid } from "@/components/widgets/WidgetsGrid";
---

<DashboardLayout title="Widgets — Alfsight">
  <div class="mx-auto w-full max-w-[900px]">
    <header class="mb-6">
      <h1 class="text-[22px] font-semibold tracking-tight text-[var(--color-text)]">Instagram Feed</h1>
      <p class="mt-1 text-[13px] text-[var(--color-text-muted)]">
        Create, edit and embed widgets on any site.
      </p>

      <div class="mt-4 flex items-center justify-end">
        <a href="/widgets/new" class="btn-primary">
          <span>Create widget</span>
          <kbd class="btn-kbd">G</kbd>
        </a>
      </div>
    </header>

    <WidgetsGrid client:load />
  </div>
</DashboardLayout>

<style>
  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    border-radius: 0.5rem;
    border: none;
    font-weight: 600;
    font-size: 13px;
    cursor: pointer;
    background: linear-gradient(var(--color-primary), var(--color-primary-hover));
    color: white;
    box-shadow: inset 0 4px 3px -2px var(--color-primary-glow), 0 4px 5px -3px rgba(0, 0, 0, 0.6);
    border-bottom: 2px solid var(--color-primary-deep);
    transition: all 0.3s ease;
    text-decoration: none;
  }

  .btn-primary:hover {
    border-bottom: 4px solid var(--color-primary-deep);
    translate: 0 -1px;
  }

  .btn-primary:active {
    box-shadow: inset 0 4px 3px -2px var(--color-primary-glow), 0 4px 5px -3px transparent;
    border-bottom: 1px solid var(--color-primary-deep);
    translate: 0 0;
  }

  .btn-kbd {
    margin-left: 0.25rem;
    padding: 0.125rem 0.5rem;
    border-radius: 0.25rem;
    font-size: 11px;
    font-weight: 600;
    font-family: inherit;
    background-color: var(--color-primary-light);
    color: white;
    box-shadow: inset 0 -3px 3px -2px #1f54f0, inset 0 3px 3px -2px #658dff,
      0 2px 2px -2px rgba(0, 0, 0, 0.3), 0 0 0 2px #0d47f0;
  }
</style>

<script>
  document.addEventListener("keydown", (e) => {
    if (e.key === "g" && !e.metaKey && !e.ctrlKey && !e.altKey) {
      const el = document.activeElement;
      if (el && (el.tagName === "INPUT" || el.tagName === "TEXTAREA" || el.tagName === "SELECT")) return;
      window.location.href = "/widgets/new";
    }
  });
</script>
