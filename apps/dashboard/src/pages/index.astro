---
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import { WidgetsGrid } from "@/components/widgets/WidgetsGrid";
import { Kbd, buttonClass } from "@/components/ui/Button";
import { Plus } from "lucide-react";
---

<DashboardLayout title="Widgets | Alfsight">
  <div class="mx-auto w-full max-w-[960px]">
    <header class="mb-6 flex flex-wrap items-center justify-between gap-4">
      <div>
        <h1 class="font-display text-2xl font-medium text-neutral-900">Widgets</h1>
        <p class="mt-1 text-sm text-neutral-500">
          Create, edit and embed Instagram feeds on any site.
        </p>
      </div>

      <a href="/widgets/new" class={buttonClass("primary", "md")}>
        <Plus size={15} strokeWidth={2} />
        <span>Create widget</span>
        <Kbd dark>G</Kbd>
      </a>
    </header>

    <WidgetsGrid client:load />
  </div>
</DashboardLayout>

<script>
  document.addEventListener("keydown", (e) => {
    if (e.key === "g" && !e.metaKey && !e.ctrlKey && !e.altKey) {
      const el = document.activeElement;
      if (el && (el.tagName === "INPUT" || el.tagName === "TEXTAREA" || el.tagName === "SELECT")) return;
      window.location.href = "/widgets/new";
    }
  });
</script>
