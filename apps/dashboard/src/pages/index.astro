---
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import { WidgetsGrid } from "@/components/widgets/WidgetsGrid";
import { Search } from "lucide-react";
---

<DashboardLayout title="Widgets — Alfsight">
  <div class="mx-auto w-full max-w-[900px]">
    <header class="mb-6">
      <h1 class="text-[22px] font-semibold tracking-tight text-[var(--color-text)]">Instagram Feed</h1>
      <p class="mt-1 text-[13px] text-[var(--color-text-muted)]">
        Create, edit and embed widgets on any site.
      </p>

      <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
        <label class="relative block min-w-0 flex-1 sm:max-w-[320px]">
          <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-[var(--color-text-soft)]">
            <Search size={16} strokeWidth={1.75} />
          </span>
          <input
            type="search"
            placeholder="Search widgets…"
            class="h-9 w-full rounded-[6px] border border-[var(--color-border)] bg-[var(--color-surface)] py-0 pl-9 pr-3 text-[13px] text-[var(--color-text)] outline-none placeholder:text-[var(--color-text-soft)] focus:border-[var(--color-primary)]"
          />
        </label>
        <a
          href="/widgets/new"
          class="inline-flex h-9 shrink-0 items-center gap-2 rounded-[6px] bg-[var(--color-primary)] px-4 text-[13px] font-medium text-[var(--color-primary-foreground)] transition-colors hover:bg-[var(--color-primary-hover)]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14"></path>
            <path d="M12 5v14"></path>
          </svg>
          Create widget
        </a>
      </div>
    </header>

    <WidgetsGrid client:load />
  </div>
</DashboardLayout>
