---
interface Props {
  class?: string;
  padded?: boolean;
}

const { class: className = "", padded = true } = Astro.props;
---

<div
  class:list={[
    "rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-[var(--color-surface)]",
    padded ? "p-6" : "",
    className,
  ]}
>
  <slot />
</div>
