---
interface Props {
  icon?: string;
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<div
  class="flex min-h-[320px] flex-col items-center justify-center rounded-[var(--radius-xl)] border border-dashed border-[var(--color-border)] bg-[var(--color-surface)] p-10 text-center"
>
  <div
    class="mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-[var(--color-surface-2)] text-[var(--color-primary)]"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
      stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
    >
      <circle cx="12" cy="12" r="9"></circle>
      <path d="M12 8v4l2.5 2.5"></path>
    </svg>
  </div>
  <h3 class="text-[15px] font-semibold text-[var(--color-text)]">{title}</h3>
  {
    description && (
      <p class="mt-1.5 max-w-sm text-[13px] text-[var(--color-text-muted)]">{description}</p>
    )
  }
</div>
