---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<header class="mb-7 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
  <div class="min-w-0">
    {
      eyebrow && (
        <p class="mb-1 text-[11px] font-medium uppercase tracking-[0.14em] text-[var(--color-text-soft)]">
          {eyebrow}
        </p>
      )
    }
    <h1 class="truncate text-[22px] font-semibold leading-tight tracking-tight text-[var(--color-text)]">
      {title}
    </h1>
    {
      description && (
        <p class="mt-1.5 max-w-xl text-[13.5px] leading-relaxed text-[var(--color-text-muted)]">
          {description}
        </p>
      )
    }
  </div>

  <div class="flex items-center gap-2">
    <slot name="actions" />
  </div>
</header>
