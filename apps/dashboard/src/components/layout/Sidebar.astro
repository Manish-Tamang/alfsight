---
import { BookOpen, LayoutGrid, LogOut, Plus, Settings } from "lucide-react";

const path = Astro.url.pathname;

const items = [
  { label: "Widgets", href: "/", icon: LayoutGrid, match: (p: string) => p === "/" || p.startsWith("/widgets/edit") },
  { label: "New widget", href: "/widgets/new", icon: Plus, match: (p: string) => p.startsWith("/widgets/new") },
  { label: "Settings", href: "/settings", icon: Settings, match: (p: string) => p.startsWith("/settings") },
] as const;
---

<aside class="sticky top-0 z-30 flex w-full flex-col bg-[var(--color-bg)] md:h-screen md:w-[240px] md:shrink-0">
  <div class="flex h-14 items-center justify-between px-4 md:h-auto md:px-3 md:pt-4 md:pb-3">
    <a href="/" class="flex items-center gap-2 rounded-lg px-1 py-1 text-black" aria-label="Alfsight home">
      <img src="/alfsight.png" alt="" width="450" height="450" class="h-6 w-6" />
      <span class="font-display text-xl font-medium tracking-tight text-neutral-800">Alfsight</span>
    </a>
  </div>

  <nav class="flex gap-1 overflow-x-auto px-3 pb-3 md:flex-1 md:flex-col md:gap-0.5 md:pb-0 scrollbar-hide">
    {
      items.map((item) => {
        const Icon = item.icon;
        const active = item.match(path);
        return (
          <a
            href={item.href}
            class:list={[
              "flex h-9 shrink-0 items-center gap-2.5 rounded-[10px] px-2.5 text-sm transition-colors",
              active
                ? "bg-white font-medium text-neutral-900 shadow-sm shadow-black/5 ring-1 ring-black/5 [&>svg]:text-brand-600"
                : "text-neutral-600 hover:bg-black/[0.04] hover:text-neutral-900",
            ]}
          >
            <Icon size={16} strokeWidth={active ? 2 : 1.75} />
            <span>{item.label}</span>
          </a>
        );
      })
    }
  </nav>

  <div class="hidden px-3 pb-4 md:block">
    <div class="dots-x mx-1 mb-3"></div>
    <a
      href="https://github.com/Manish-Tamang/alfsight#readme"
      target="_blank"
      rel="noopener noreferrer"
      class="flex h-9 items-center gap-2.5 rounded-[10px] px-2.5 text-sm text-neutral-600 transition-colors hover:bg-black/[0.04] hover:text-neutral-900"
    >
      <BookOpen size={16} strokeWidth={1.75} />
      Docs
    </a>
    {
      !import.meta.env.DEV && (
        <button
          type="button"
          data-sign-out
          class="flex h-9 w-full items-center gap-2.5 rounded-[10px] px-2.5 text-sm text-neutral-600 transition-colors hover:bg-black/[0.04] hover:text-neutral-900"
        >
          <LogOut size={16} strokeWidth={1.75} />
          Sign out
        </button>
      )
    }
  </div>
</aside>

<script>
  import { clearToken } from "@/lib/auth";

  document.querySelector("[data-sign-out]")?.addEventListener("click", () => {
    clearToken();
    window.location.href = "/login";
  });
</script>
