---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navbar from "@/components/Navbar.astro";
import Footer from "@/components/Footer.astro";
import CodeBlock from "@/components/ui/CodeBlock.astro";
---

<BaseLayout title="Docs | Alfsight | Open-Source Elfsight Alternative" description="Complete guide to self-hosting Alfsight: fork, install, configure, and deploy your own Instagram feed widget service.">
  <Navbar
    links={[
      { label: "Home", href: "/" },
      { label: "Features", href: "/#features" },
      { label: "Docs", href: "/docs", active: true },
    ]}
  />

  <main class="border-t border-neutral-200">
    <div class="mx-auto flex max-w-6xl gap-0 lg:gap-8">

      <!-- Sidebar -->
      <aside class="hidden lg:block sticky top-14 h-[calc(100vh-3.5rem)] w-56 shrink-0 overflow-y-auto border-r border-[var(--color-border-soft)] py-8 pl-6 pr-4">
        <nav class="flex flex-col gap-1">
          <p class="mb-2 text-xs font-medium text-neutral-900">Getting started</p>
          <a href="#overview" class="docs-nav-link">Overview</a>
          <a href="#prerequisites" class="docs-nav-link">Prerequisites</a>
          <a href="#fork-and-clone" class="docs-nav-link">Fork & clone</a>
          <a href="#install-dependencies" class="docs-nav-link">Install dependencies</a>
          <a href="#environment-variables" class="docs-nav-link">Environment variables</a>
          <a href="#cloudflare-setup" class="docs-nav-link">Cloudflare setup</a>
          <a href="#database-setup" class="docs-nav-link">Database & migrations</a>
          <a href="#running-locally" class="docs-nav-link">Running locally</a>

          <p class="mb-2 mt-5 text-xs font-medium text-neutral-900">Usage</p>
          <a href="#creating-a-widget" class="docs-nav-link">Creating a widget</a>
          <a href="#embedding" class="docs-nav-link">Embedding</a>
          <a href="#widget-attributes" class="docs-nav-link">Widget attributes</a>
          <a href="#customization" class="docs-nav-link">Customization</a>

          <p class="mb-2 mt-5 text-xs font-medium text-neutral-900">API</p>
          <a href="#api-reference" class="docs-nav-link">API reference</a>
          <a href="#authentication" class="docs-nav-link">Authentication</a>

          <p class="mb-2 mt-5 text-xs font-medium text-neutral-900">Deploy</p>
          <a href="#deploy-production" class="docs-nav-link">Production deploy</a>
          <a href="#project-structure" class="docs-nav-link">Project structure</a>
        </nav>
      </aside>

      <!-- Content -->
      <div class="min-w-0 flex-1 px-6 py-10 lg:px-10 lg:py-12">

        <!-- Overview -->
        <section id="overview" class="docs-section">
          <h1 class="font-display text-4xl font-medium text-neutral-900">Documentation</h1>
          <p class="mt-3 max-w-2xl text-[15px] leading-relaxed text-[var(--color-text-muted)]">
            Alfsight is a self-hosted alternative to Elfsight for embedding Instagram feeds on any website. It fetches public Instagram data via the <a href="https://openhandle.dev" target="_blank" rel="noopener noreferrer" class="font-medium text-brand-700 underline decoration-brand-200 underline-offset-2 hover:decoration-brand-600">OpenHandle API</a>, caches it at the edge with Cloudflare KV, and serves it through a zero-dependency Web Component that weighs under 6 kB gzipped.
          </p>
          <div class="mt-6 rounded-lg border border-[var(--color-border-soft)] bg-[var(--color-surface-2)] p-4 text-[13px] leading-relaxed text-[var(--color-text-muted)]">
            <strong class="text-[var(--color-text)]">Architecture:</strong> Monorepo with pnpm workspaces &mdash; API (Hono on Cloudflare Workers), Dashboard (Astro + React), Widget (vanilla Web Component), and shared packages for types and validation. Data flows: visitor loads widget &rarr; widget calls API &rarr; API checks KV cache &rarr; cache miss hits D1 &rarr; cron syncs from OpenHandle.
          </div>
        </section>

        <!-- Prerequisites -->
        <section id="prerequisites" class="docs-section">
          <h2 class="docs-h2">Prerequisites</h2>
          <ul class="docs-list">
            <li><strong>Node.js</strong> &ge; 18</li>
            <li><strong>pnpm</strong> &ge; 8 &mdash; install with <code class="docs-code">npm install -g pnpm</code></li>
            <li>A <strong>Cloudflare account</strong> (free tier works) for Workers, D1, and KV</li>
            <li>An <strong>OpenHandle API key</strong> from <a href="https://openhandle.dev" target="_blank" rel="noopener noreferrer" class="font-medium text-brand-700 underline decoration-brand-200 underline-offset-2 hover:decoration-brand-600">openhandle.dev</a> (test key is free)</li>
            <li><strong>Git</strong> installed</li>
          </ul>
        </section>

        <!-- Fork & Clone -->
        <section id="fork-and-clone" class="docs-section">
          <h2 class="docs-h2">Fork & clone</h2>
          <p class="docs-p">Fork the repository on GitHub, then clone your fork locally:</p>
          <CodeBlock lang="bash" code={`# Fork via GitHub UI or CLI
gh repo fork Manish-Tamang/alfsight --clone

# Or clone manually after forking
git clone https://github.com/YOUR_USERNAME/alfsight.git
cd alfsight`} />
          <p class="docs-p">If you just want to try it without forking:</p>
          <CodeBlock lang="bash" code={`git clone https://github.com/Manish-Tamang/alfsight.git
cd alfsight`} />
        </section>

        <!-- Install Dependencies -->
        <section id="install-dependencies" class="docs-section">
          <h2 class="docs-h2">Install dependencies</h2>
          <CodeBlock lang="bash" code={`pnpm install`} />
          <p class="docs-p">This installs all workspace dependencies across the monorepo: <code class="docs-code">apps/api</code>, <code class="docs-code">apps/dashboard</code>, <code class="docs-code">apps/widget</code>, <code class="docs-code">apps/web</code>, <code class="docs-code">packages/types</code>, <code class="docs-code">packages/validation</code>, and <code class="docs-code">database</code>.</p>
        </section>

        <!-- Environment Variables -->
        <section id="environment-variables" class="docs-section">
          <h2 class="docs-h2">Environment variables</h2>
          <p class="docs-p">Copy the example env file and fill in your values:</p>
          <CodeBlock lang="bash" code={`cp .env.example .env`} />

          <h3 class="docs-h3">Root <code class="docs-code">.env</code></h3>
          <div class="docs-table-wrap">
            <table class="docs-table">
              <thead>
                <tr>
                  <th>Variable</th>
                  <th>Description</th>
                  <th>Default</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><code class="docs-code">API_BASE_URL</code></td>
                  <td>URL of the API worker</td>
                  <td><code class="docs-code">http://localhost:8787</code></td>
                </tr>
                <tr>
                  <td><code class="docs-code">VITE_API_BASE_URL</code></td>
                  <td>API URL exposed to the dashboard frontend</td>
                  <td><code class="docs-code">http://localhost:8787</code></td>
                </tr>
                <tr>
                  <td><code class="docs-code">OPENHANDLE_TEST_KEY</code></td>
                  <td>OpenHandle test API key (for development)</td>
                  <td>&mdash;</td>
                </tr>
                <tr>
                  <td><code class="docs-code">OPENHANDLE_LIVE_KEY</code></td>
                  <td>OpenHandle live API key (for production)</td>
                  <td>&mdash;</td>
                </tr>
              </tbody>
            </table>
          </div>

          <h3 class="docs-h3">API secrets <code class="docs-code">apps/api/.dev.vars</code></h3>
          <p class="docs-p">The API worker reads secrets from <code class="docs-code">.dev.vars</code> during local development (Wrangler convention). Create this file:</p>
          <CodeBlock lang="dotenv" title="apps/api/.dev.vars" code={`# OpenHandle — at least one key is required
OPENHANDLE_TEST_KEY=oh_test_your_key_here
OPENHANDLE_LIVE_KEY=oh_live_your_key_here

# Meta OAuth (optional, for Instagram account linking)
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_REDIRECT_URI=http://localhost:8787/api/instagram/callback

# Environment
ENVIRONMENT=development`} />

          <div class="mt-4 rounded-lg border border-amber-200 bg-amber-50 p-4 text-[13px] leading-relaxed text-amber-900">
            <strong>Important:</strong> Never commit <code class="docs-code">.env</code> or <code class="docs-code">.dev.vars</code>. Both are already in <code class="docs-code">.gitignore</code>. For production, use <code class="docs-code">wrangler secret put &lt;KEY&gt;</code> to set secrets securely.
          </div>

          <h3 class="docs-h3">Getting an OpenHandle API key</h3>
          <ol class="docs-list list-decimal">
            <li>Go to <a href="https://openhandle.dev" target="_blank" rel="noopener noreferrer" class="font-medium text-brand-700 underline decoration-brand-200 underline-offset-2 hover:decoration-brand-600">openhandle.dev</a></li>
            <li>Create an account and generate a <strong>Test</strong> key for development</li>
            <li>Add the key to both <code class="docs-code">.env</code> and <code class="docs-code">apps/api/.dev.vars</code></li>
            <li>For production, generate a <strong>Live</strong> key and set it via <code class="docs-code">wrangler secret put OPENHANDLE_LIVE_KEY</code></li>
          </ol>
        </section>

        <!-- Cloudflare Setup -->
        <section id="cloudflare-setup" class="docs-section">
          <h2 class="docs-h2">Cloudflare setup</h2>
          <p class="docs-p">The API runs on Cloudflare Workers with D1 (database) and KV (cache). You need to create these resources and update <code class="docs-code">wrangler.jsonc</code>.</p>

          <h3 class="docs-h3">1. Login to Wrangler</h3>
          <CodeBlock lang="bash" code={`npx wrangler login`} />

          <h3 class="docs-h3">2. Create a D1 database</h3>
          <CodeBlock lang="bash" code={`npx wrangler d1 create instagram-widget-db`} />
          <p class="docs-p">Copy the returned <code class="docs-code">database_id</code> and paste it into <code class="docs-code">apps/api/wrangler.jsonc</code>:</p>
          <CodeBlock lang="jsonc" title="apps/api/wrangler.jsonc" code={`"d1_databases": [
  {
    "binding": "DB",
    "database_name": "instagram-widget-db",
    "database_id": "YOUR_DATABASE_ID"
  }
]`} />

          <h3 class="docs-h3">3. Create a KV namespace</h3>
          <CodeBlock lang="bash" code={`npx wrangler kv namespace create FEED_CACHE`} />
          <p class="docs-p">Copy the returned <code class="docs-code">id</code> and update <code class="docs-code">wrangler.jsonc</code>:</p>
          <CodeBlock lang="jsonc" title="apps/api/wrangler.jsonc" code={`"kv_namespaces": [
  {
    "binding": "FEED_CACHE",
    "id": "YOUR_KV_NAMESPACE_ID"
  }
]`} />
        </section>

        <!-- Database Setup -->
        <section id="database-setup" class="docs-section">
          <h2 class="docs-h2">Database & migrations</h2>
          <p class="docs-p">The project uses Drizzle ORM with Cloudflare D1 (SQLite). Migrations are generated from the schema at <code class="docs-code">database/schema.ts</code>.</p>

          <h3 class="docs-h3">Generate migrations (if schema changed)</h3>
          <CodeBlock lang="bash" code={`pnpm db:generate`} />

          <h3 class="docs-h3">Apply migrations locally</h3>
          <CodeBlock lang="bash" code={`# Apply each migration file in order
pnpm --filter @instagram-widget/api exec wrangler d1 execute \\
  instagram-widget-db --local \\
  --file=../../database/migrations/0000_bouncy_peter_parker.sql

pnpm --filter @instagram-widget/api exec wrangler d1 execute \\
  instagram-widget-db --local \\
  --file=../../database/migrations/0001_old_risque.sql`} />

          <h3 class="docs-h3">Apply migrations to production</h3>
          <CodeBlock lang="bash" code={`# Same commands without --local
pnpm --filter @instagram-widget/api exec wrangler d1 execute \\
  instagram-widget-db \\
  --file=../../database/migrations/0000_bouncy_peter_parker.sql`} />

          <h3 class="docs-h3">Database schema</h3>
          <p class="docs-p">The D1 database has four tables:</p>
          <div class="docs-table-wrap">
            <table class="docs-table">
              <thead>
                <tr>
                  <th>Table</th>
                  <th>Purpose</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><code class="docs-code">users</code></td>
                  <td>User accounts (id, email)</td>
                </tr>
                <tr>
                  <td><code class="docs-code">instagram_accounts</code></td>
                  <td>Linked Instagram accounts with OAuth tokens</td>
                </tr>
                <tr>
                  <td><code class="docs-code">feeds</code></td>
                  <td>Widget configurations (name, JSON settings)</td>
                </tr>
                <tr>
                  <td><code class="docs-code">posts</code></td>
                  <td>Cached Instagram posts (media URL, caption, type, likes)</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>

        <!-- Running Locally -->
        <section id="running-locally" class="docs-section">
          <h2 class="docs-h2">Running locally</h2>
          <CodeBlock lang="bash" code={`# Run all apps in parallel
pnpm dev

# Or run individually
pnpm dev:api         # API       → http://localhost:8787
pnpm dev:dashboard   # Dashboard → http://localhost:5173
pnpm dev:widget      # Widget    → http://localhost:5174
pnpm dev:web         # Docs site → http://localhost:4321`} />

          <div class="mt-4 rounded-lg border border-[var(--color-border-soft)] bg-[var(--color-surface-2)] p-4 text-[13px] leading-relaxed text-[var(--color-text-muted)]">
            <strong class="text-[var(--color-text)]">Tip:</strong> The API uses Wrangler's local mode, which emulates D1 and KV in-memory. No Cloudflare account is needed for local development &mdash; just the API key in <code class="docs-code">.dev.vars</code>.
          </div>

          <h3 class="docs-h3">Dev auth shortcut</h3>
          <p class="docs-p">In development mode, the API accepts a <code class="docs-code">x-dev-user-id</code> header to simulate authentication without OAuth:</p>
          <CodeBlock lang="bash" code={`curl http://localhost:8787/api/feeds \\
  -H "x-dev-user-id: dev-user-1"`} />
        </section>

        <!-- Creating a Widget -->
        <section id="creating-a-widget" class="docs-section">
          <h2 class="docs-h2">Creating a widget</h2>
          <ol class="docs-list list-decimal">
            <li>Open the dashboard at <code class="docs-code">http://localhost:5173</code></li>
            <li>Click <strong>Create widget</strong> (or press <kbd class="docs-kbd">G</kbd>)</li>
            <li>Enter an Instagram username and widget name</li>
            <li>The editor opens with a live preview &mdash; configure layout, columns, gap, radius, card style, hover effects, and background color</li>
            <li>Switch to the <strong>Deploy</strong> tab to get the embed snippet</li>
          </ol>
        </section>

        <!-- Embedding -->
        <section id="embedding" class="docs-section">
          <h2 class="docs-h2">Embedding</h2>
          <p class="docs-p">Add two lines to any HTML page:</p>
          <CodeBlock lang="html" title="HTML" code={`<!-- Load the widget script -->
<script src="https://your-domain.com/instagram.js" defer></script>

<!-- Place the widget -->
<instagram-feed
  feed="YOUR_FEED_ID"
  api-base="https://your-api.workers.dev"
></instagram-feed>`} />
          <p class="docs-p">The widget uses Shadow DOM for complete style isolation &mdash; it won't conflict with your page's CSS. Works with plain HTML, WordPress, Shopify, Webflow, React, Vue, Next.js, or any platform that renders HTML.</p>
        </section>

        <!-- Widget Attributes -->
        <section id="widget-attributes" class="docs-section">
          <h2 class="docs-h2">Widget attributes</h2>
          <div class="docs-table-wrap">
            <table class="docs-table">
              <thead>
                <tr>
                  <th>Attribute</th>
                  <th>Required</th>
                  <th>Description</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><code class="docs-code">feed</code></td>
                  <td>Yes</td>
                  <td>The feed ID from your dashboard</td>
                </tr>
                <tr>
                  <td><code class="docs-code">api-base</code></td>
                  <td>No</td>
                  <td>API URL. Defaults to the bundled origin. Required if widget is served from a different domain than the API.</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>

        <!-- Customization -->
        <section id="customization" class="docs-section">
          <h2 class="docs-h2">Customization</h2>
          <p class="docs-p">All settings are stored in the feed's JSON settings and applied via CSS custom properties in the Shadow DOM:</p>
          <div class="docs-table-wrap">
            <table class="docs-table">
              <thead>
                <tr>
                  <th>Setting</th>
                  <th>CSS variable</th>
                  <th>Default</th>
                  <th>Description</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>Columns</td>
                  <td><code class="docs-code">--ig-grid-columns</code></td>
                  <td>4</td>
                  <td>Number of columns (1&ndash;6)</td>
                </tr>
                <tr>
                  <td>Gap</td>
                  <td><code class="docs-code">--ig-grid-gap</code></td>
                  <td>14px</td>
                  <td>Space between posts</td>
                </tr>
                <tr>
                  <td>Border radius</td>
                  <td><code class="docs-code">--ig-border-radius</code></td>
                  <td>6px</td>
                  <td>Corner radius of post cards</td>
                </tr>
                <tr>
                  <td>Background</td>
                  <td><code class="docs-code">--ig-bg-color</code></td>
                  <td>transparent</td>
                  <td>Widget container background color</td>
                </tr>
              </tbody>
            </table>
          </div>

          <h3 class="docs-h3">Feed settings reference</h3>
          <div class="docs-table-wrap">
            <table class="docs-table">
              <thead>
                <tr>
                  <th>Property</th>
                  <th>Type</th>
                  <th>Description</th>
                </tr>
              </thead>
              <tbody>
                <tr><td><code class="docs-code">layout</code></td><td><code class="docs-code">"grid" | "masonry" | "showcase"</code></td><td>Feed layout mode</td></tr>
                <tr><td><code class="docs-code">columns</code></td><td><code class="docs-code">number</code></td><td>Grid columns (1&ndash;6)</td></tr>
                <tr><td><code class="docs-code">rows</code></td><td><code class="docs-code">number</code></td><td>Grid rows</td></tr>
                <tr><td><code class="docs-code">gap</code></td><td><code class="docs-code">number</code></td><td>Gap in pixels</td></tr>
                <tr><td><code class="docs-code">borderRadius</code></td><td><code class="docs-code">number</code></td><td>Corner radius in pixels</td></tr>
                <tr><td><code class="docs-code">cardStyle</code></td><td><code class="docs-code">"clean" | "rounded" | "elevated"</code></td><td>Card appearance</td></tr>
                <tr><td><code class="docs-code">hoverStyle</code></td><td><code class="docs-code">"zoom" | "overlay" | "lift" | "none"</code></td><td>Hover animation</td></tr>
                <tr><td><code class="docs-code">showCaption</code></td><td><code class="docs-code">boolean</code></td><td>Show captions on hover</td></tr>
                <tr><td><code class="docs-code">showHeader</code></td><td><code class="docs-code">boolean</code></td><td>Show profile header</td></tr>
                <tr><td><code class="docs-code">backgroundColor</code></td><td><code class="docs-code">string</code></td><td>Container background (any CSS color)</td></tr>
                <tr><td><code class="docs-code">postCount</code></td><td><code class="docs-code">number</code></td><td>Max posts to display</td></tr>
                <tr><td><code class="docs-code">order</code></td><td><code class="docs-code">"newest" | "oldest"</code></td><td>Post sort order</td></tr>
              </tbody>
            </table>
          </div>
        </section>

        <!-- API Reference -->
        <section id="api-reference" class="docs-section">
          <h2 class="docs-h2">API reference</h2>
          <p class="docs-p">Base URL: <code class="docs-code">http://localhost:8787</code> (local) or your deployed Workers URL.</p>

          <h3 class="docs-h3">Public endpoints (no auth)</h3>
          <div class="docs-endpoint-list">
            <div class="docs-endpoint">
              <span class="docs-method docs-method-get">GET</span>
              <code>/api/health</code>
              <span class="text-[var(--color-text-muted)]">&mdash; Service health check</span>
            </div>
            <div class="docs-endpoint">
              <span class="docs-method docs-method-get">GET</span>
              <code>/api/feeds/:id</code>
              <span class="text-[var(--color-text-muted)]">&mdash; Fetch feed with posts (KV-cached)</span>
            </div>
            <div class="docs-endpoint">
              <span class="docs-method docs-method-get">GET</span>
              <code>/api/instagram/:identifier</code>
              <span class="text-[var(--color-text-muted)]">&mdash; Public profile lookup</span>
            </div>
            <div class="docs-endpoint">
              <span class="docs-method docs-method-get">GET</span>
              <code>/api/instagram/:identifier/posts</code>
              <span class="text-[var(--color-text-muted)]">&mdash; Paginated posts</span>
            </div>
            <div class="docs-endpoint">
              <span class="docs-method docs-method-get">GET</span>
              <code>/api/instagram/:identifier/reels</code>
              <span class="text-[var(--color-text-muted)]">&mdash; Paginated reels</span>
            </div>
            <div class="docs-endpoint">
              <span class="docs-method docs-method-get">GET</span>
              <code>/api/instagram/:identifier/stories</code>
              <span class="text-[var(--color-text-muted)]">&mdash; Current stories</span>
            </div>
            <div class="docs-endpoint">
              <span class="docs-method docs-method-get">GET</span>
              <code>/api/instagram/:identifier/highlights</code>
              <span class="text-[var(--color-text-muted)]">&mdash; Public highlights</span>
            </div>
            <div class="docs-endpoint">
              <span class="docs-method docs-method-get">GET</span>
              <code>/api/instagram/:identifier/followers</code>
              <span class="text-[var(--color-text-muted)]">&mdash; Paginated followers</span>
            </div>
            <div class="docs-endpoint">
              <span class="docs-method docs-method-get">GET</span>
              <code>/api/instagram/:identifier/following</code>
              <span class="text-[var(--color-text-muted)]">&mdash; Paginated following</span>
            </div>
          </div>

          <h3 class="docs-h3">Authenticated endpoints</h3>
          <div class="docs-endpoint-list">
            <div class="docs-endpoint">
              <span class="docs-method docs-method-get">GET</span>
              <code>/api/feeds</code>
              <span class="text-[var(--color-text-muted)]">&mdash; List all feeds for current user</span>
            </div>
            <div class="docs-endpoint">
              <span class="docs-method docs-method-post">POST</span>
              <code>/api/feeds</code>
              <span class="text-[var(--color-text-muted)]">&mdash; Create a new feed</span>
            </div>
            <div class="docs-endpoint">
              <span class="docs-method docs-method-patch">PATCH</span>
              <code>/api/feeds/:id</code>
              <span class="text-[var(--color-text-muted)]">&mdash; Update feed settings</span>
            </div>
            <div class="docs-endpoint">
              <span class="docs-method docs-method-delete">DELETE</span>
              <code>/api/feeds/:id</code>
              <span class="text-[var(--color-text-muted)]">&mdash; Delete a feed</span>
            </div>
            <div class="docs-endpoint">
              <span class="docs-method docs-method-post">POST</span>
              <code>/api/feeds/:id/refresh</code>
              <span class="text-[var(--color-text-muted)]">&mdash; Trigger manual sync</span>
            </div>
            <div class="docs-endpoint">
              <span class="docs-method docs-method-post">POST</span>
              <code>/api/instagram/connect</code>
              <span class="text-[var(--color-text-muted)]">&mdash; Start OAuth flow</span>
            </div>
            <div class="docs-endpoint">
              <span class="docs-method docs-method-get">GET</span>
              <code>/api/instagram/callback</code>
              <span class="text-[var(--color-text-muted)]">&mdash; OAuth redirect callback</span>
            </div>
            <div class="docs-endpoint">
              <span class="docs-method docs-method-get">GET</span>
              <code>/api/instagram/accounts</code>
              <span class="text-[var(--color-text-muted)]">&mdash; List linked accounts</span>
            </div>
          </div>
                  <h3 class="docs-h3">Examples</h3>
          <p class="docs-p">Fetch a feed the same way the widget does. This route is public and served from the KV cache:</p>
          <CodeBlock lang="bash" code={`curl http://localhost:8787/api/feeds/FEED_ID`} />
          <CodeBlock lang="json" title="200 OK" code={`{
  "id": "a1b2c3d4e5f6g7h8",
  "name": "Homepage feed",
  "settings": {
    "instagramHandle": "natgeo",
    "layout": "grid",
    "columns": 4,
    "rows": 2,
    "gap": 16,
    "borderRadius": 8
  },
  "profile": {
    "name": "National Geographic",
    "username": "natgeo",
    "avatarUrl": "https://…/avatar.jpg",
    "followUrl": "https://instagram.com/natgeo",
    "posts": 31000,
    "followers": 280000000,
    "following": 150
  },
  "posts": [
    {
      "id": "3412…",
      "type": "IMAGE",
      "imageUrl": "https://…/post.jpg",
      "thumbnailUrl": null,
      "permalink": "https://instagram.com/p/…",
      "caption": "Into the wild",
      "likeCount": 120394,
      "timestamp": "2026-10-20T14:32:00.000Z"
    }
  ]
}`} />

          <p class="docs-p">Create a feed for a public Instagram profile. Posts sync right away:</p>
          <CodeBlock lang="bash" code={`curl -X POST http://localhost:8787/api/feeds \\
  -H "Content-Type: application/json" \\
  -H "x-dev-user-id: dev-user-1" \\
  -d '{
    "name": "Homepage feed",
    "settings": { "instagramHandle": "natgeo", "layout": "grid", "columns": 4 }
  }'`} />
          <CodeBlock lang="json" title="201 Created" code={`{
  "id": "a1b2c3d4e5f6g7h8",
  "name": "Homepage feed",
  "instagramAccountId": null,
  "settings": { "instagramHandle": "natgeo", "layout": "grid", "columns": 4 },
  "createdAt": "2026-10-27T09:00:00.000Z",
  "updatedAt": "2026-10-27T09:00:00.000Z"
}`} />

          <p class="docs-p">Update settings from your own code. Send only the fields you want to change:</p>
          <CodeBlock lang="ts" title="update-feed.ts" code={`const res = await fetch(\`\${API_BASE}/api/feeds/\${feedId}\`, {
  method: "PATCH",
  headers: {
    "Content-Type": "application/json",
    "x-dev-user-id": "dev-user-1",
  },
  body: JSON.stringify({
    settings: { layout: "masonry", gap: 8, hoverStyle: "overlay" },
  }),
});

if (!res.ok) {
  const { error } = await res.json();
  throw new Error(\`\${error.code}: \${error.message}\`);
}`} />

          <p class="docs-p">Trigger a manual sync:</p>
          <CodeBlock lang="bash" code={`curl -X POST http://localhost:8787/api/feeds/FEED_ID/refresh \\
  -H "x-dev-user-id: dev-user-1"`} />
          <CodeBlock lang="json" title="200 OK" code={`{ "message": "Feed refreshed successfully", "syncedPosts": 12 }`} />

          <h3 class="docs-h3">Errors</h3>
          <p class="docs-p">Every error uses the same shape, with a machine-readable <code class="docs-code">code</code>:</p>
          <CodeBlock lang="json" title="404 Not Found" code={`{
  "error": {
    "code": "FEED_NOT_FOUND",
    "message": "Feed not found"
  }
}`} />
        </section>

        <!-- Authentication -->
        <section id="authentication" class="docs-section">
          <h2 class="docs-h2">Authentication</h2>
          <p class="docs-p">In <strong>development</strong>, pass the dev header to simulate a user:</p>
          <CodeBlock lang="http" title="HTTP header" code={`x-dev-user-id: dev-user-1`} />
          <p class="docs-p">The dashboard sends this header automatically in development mode. In <strong>production</strong>, the dev header is ignored and authenticated routes require <code class="docs-code">Authorization: Bearer &lt;ADMIN_TOKEN&gt;</code>. The dashboard asks for this token on its sign-in page.</p>
        </section>

        <!-- Production Deploy -->
        <section id="deploy-production" class="docs-section">
          <h2 class="docs-h2">Production deploy</h2>
          <p class="docs-p">Everything runs on Cloudflare: the API is a Worker, and the widget, dashboard and this site are Cloudflare Pages projects. All commands run from the repo root.</p>

          <h3 class="docs-h3">1. Log in and create the database and cache</h3>
          <CodeBlock lang="bash" code={`pnpm wrangler login
pnpm wrangler d1 create instagram-widget-db
pnpm wrangler kv namespace create FEED_CACHE`} />
          <p class="docs-p">Paste the printed <code class="docs-code">database_id</code> and KV <code class="docs-code">id</code> into <code class="docs-code">apps/api/wrangler.jsonc</code>, then create the tables:</p>
          <CodeBlock lang="bash" code={`pnpm db:migrate:remote`} />

          <h3 class="docs-h3">2. Set secrets</h3>
          <CodeBlock lang="bash" code={`# Dashboard sign-in token (generate a long random value)
openssl rand -hex 32
pnpm wrangler secret put ADMIN_TOKEN --config apps/api/wrangler.jsonc

# OpenHandle key used to fetch public Instagram data
pnpm wrangler secret put OPENHANDLE_LIVE_KEY --config apps/api/wrangler.jsonc`} />

          <h3 class="docs-h3">3. Deploy the API and widget</h3>
          <CodeBlock lang="bash" code={`pnpm deploy:api     # → https://instagram-widget-api.<you>.workers.dev
pnpm deploy:widget  # → https://alfsight-widget.pages.dev`} />
          <p class="docs-p">Cron triggers (<code class="docs-code">0 */6 * * *</code>) activate on deploy and re-sync every feed every 6 hours.</p>

          <h3 class="docs-h3">4. Deploy the dashboard</h3>
          <p class="docs-p">Point the dashboard at your API and widget URLs, then deploy:</p>
          <CodeBlock lang="dotenv" title="apps/dashboard/.env.production" code={`PUBLIC_API_BASE=https://instagram-widget-api.<you>.workers.dev
PUBLIC_WIDGET_URL=https://alfsight-widget.pages.dev`} />
          <CodeBlock lang="bash" code={`pnpm deploy:dashboard  # → https://alfsight-dashboard.pages.dev`} />
          <p class="docs-p">Open the dashboard and sign in with your <code class="docs-code">ADMIN_TOKEN</code>. The Install button now copies a production snippet that loads <code class="docs-code">instagram.iife.js</code> from your widget project.</p>

          <h3 class="docs-h3">5. Deploy this site (optional)</h3>
          <CodeBlock lang="dotenv" title="apps/web/.env.production" code={`PUBLIC_DASHBOARD_URL=https://alfsight-dashboard.pages.dev`} />
          <CodeBlock lang="bash" code={`pnpm deploy:web  # → https://alfsight.pages.dev`} />
          <p class="docs-p">If a <code class="docs-code">*.pages.dev</code> name is taken, Cloudflare gives the project a different subdomain. Use the URL the deploy prints in the env files above. Custom domains can be added under Pages → Custom domains.</p>
        </section>

        <!-- Project Structure -->
        <section id="project-structure" class="docs-section">
          <h2 class="docs-h2">Project structure</h2>
          <CodeBlock lang="bash" title="tree" code={`alfsight/
├── apps/
│   ├── api/              # Cloudflare Workers API (Hono + Drizzle)
│   │   ├── src/
│   │   │   ├── index.ts         # Entry point, routes, middleware
│   │   │   ├── middleware/      # Auth, services injection
│   │   │   ├── routes/          # feeds, instagram, health
│   │   │   ├── services/        # Feed, cache, Instagram providers
│   │   │   └── types/           # Env bindings, app variables
│   │   ├── wrangler.jsonc       # D1, KV, cron config
│   │   └── .dev.vars            # Local secrets (gitignored)
│   │
│   ├── dashboard/        # Admin UI (Astro + React + Tailwind v4)
│   │   └── src/
│   │       ├── pages/           # index, settings, widgets/[id]
│   │       ├── components/      # Sidebar, WidgetEditor, WidgetsGrid
│   │       ├── layouts/         # DashboardLayout
│   │       └── styles/          # global.css (theme vars)
│   │
│   ├── widget/           # Embeddable Web Component (< 6 kB)
│   │   └── src/
│   │       ├── widget.ts        # <instagram-feed> custom element
│   │       ├── styles.ts        # Shadow DOM styles
│   │       └── api.ts           # Feed fetch client
│   │
│   └── web/              # Landing page & docs (Astro)
│       └── src/
│           ├── pages/           # index, docs
│           ├── components/      # Navbar, Hero, Features, etc.
│           └── layouts/         # BaseLayout
│
├── packages/
│   ├── types/            # Shared TypeScript interfaces
│   └── validation/       # Shared Zod schemas
│
├── database/
│   ├── schema.ts         # Drizzle ORM schema (users, feeds, posts)
│   └── migrations/       # Auto-generated SQL files
│
├── .env.example          # Template for root env
├── pnpm-workspace.yaml   # Workspace config
└── package.json          # Root scripts (dev, build, db)`} />
        </section>

