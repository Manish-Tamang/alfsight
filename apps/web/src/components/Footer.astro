---
import Logo from "./ui/Logo.astro";

const columns = [
  {
    title: "Product",
    links: [
      { label: "Features", href: "/#features" },
      { label: "How it works", href: "/#how-it-works" },
      { label: "Dashboard", href: "/dashboard" },
    ],
  },
  {
    title: "Resources",
    links: [
      { label: "Docs", href: "/docs" },
      { label: "API reference", href: "/docs#api-reference" },
      { label: "GitHub", href: "https://github.com/Manish-Tamang/alfsight" },
    ],
  },
];
---

<footer class="grid-section">
  <div class="grid-col">
    <div class="flex flex-col gap-10 px-6 py-12 sm:flex-row sm:justify-between sm:px-10 sm:py-16">
      <div class="max-w-xs">
        <a href="/" class="flex items-center gap-2 text-black">
          <Logo class="h-6 w-6" />
          <span class="font-display text-[17px] font-bold tracking-tight">Alfsight</span>
        </a>
        <p class="mt-4 text-sm text-neutral-500">
          Self-hosted Instagram feed widgets, cached at the edge.
        </p>
        <p class="mt-6 text-xs text-neutral-400">&copy; {new Date().getFullYear()} Alfsight</p>
      </div>

      <div class="grid grid-cols-2 gap-12">
        {columns.map((col) => (
          <div>
            <h3 class="text-sm font-medium text-neutral-900">{col.title}</h3>
            <ul class="mt-3 flex flex-col gap-2.5">
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    {...(link.href.startsWith("http") ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                    class="text-sm text-neutral-500 transition-colors hover:text-neutral-700"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </div>
</footer>
