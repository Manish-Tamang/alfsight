---
import Logo from "./ui/Logo.astro";
import GitHubIcon from "./ui/GitHubIcon.astro";
import { DASHBOARD_URL } from "@/lib/site";

const repo = "https://github.com/Manish-Tamang/alfsight";

const columns = [
  {
    title: "Product",
    links: [
      { label: "Features", href: "/#features" },
      { label: "How it works", href: "/#how-it-works" },
      { label: "Compare", href: "/#compare" },
      { label: "Dashboard", href: DASHBOARD_URL },
    ],
  },
  {
    title: "Resources",
    links: [
      { label: "Docs", href: "/docs" },
      { label: "API reference", href: "/docs#api-reference" },
      { label: "FAQ", href: "/#faq" },
    ],
  },
  {
    title: "Open source",
    links: [
      { label: "GitHub", href: repo },
      { label: "Issues", href: `${repo}/issues` },
      { label: "MIT License", href: `${repo}/blob/main/LICENSE` },
    ],
  },
];
---

<footer>
  <div class="frame px-6 pt-16 pb-10 sm:px-8">
    <div class="flex flex-col gap-12 md:flex-row md:justify-between">
      <div class="max-w-xs">
        <a href="/" class="flex items-center gap-2">
          <Logo class="size-6" />
          <span class="font-display text-xl font-medium tracking-tight text-neutral-800">Alfsight</span>
        </a>
        <p class="mt-4 text-base leading-relaxed text-neutral-500">
          The open-source alternative to Elfsight. Instagram feeds for any website.
        </p>
        <a href={repo} target="_blank" rel="noopener noreferrer" class="mt-5 inline-flex text-neutral-500 transition-colors hover:text-neutral-900" aria-label="Alfsight on GitHub">
          <GitHubIcon class="size-[18px]" />
        </a>
      </div>

      <div class="grid grid-cols-2 gap-10 sm:grid-cols-3 sm:gap-16">
        {columns.map((col) => (
          <div>
            <h3 class="text-xs font-medium uppercase tracking-wider text-neutral-500">{col.title}</h3>
            <ul class="mt-4 space-y-3">
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    {...(link.href.startsWith("http") ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                    class="text-base text-neutral-700 transition-colors hover:text-neutral-900"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-16 flex flex-col gap-2 text-sm text-neutral-500 sm:flex-row sm:justify-between">
      <p>&copy; {new Date().getFullYear()} Alfsight &middot; MIT licensed</p>
      <a href={repo} target="_blank" rel="noopener noreferrer" class="hover:text-neutral-800">github.com/Manish-Tamang/alfsight</a>
    </div>
  </div>
</footer>
