---
import Logo from "./ui/Logo.astro";
import FeatureCard from "./ui/FeatureCard.astro";

const icons: Record<string, string> = {
  bolt: '<path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/>',
  box: '<path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/>',
  sliders: '<path d="M4 21v-7"/><path d="M4 10V3"/><path d="M12 21v-9"/><path d="M12 8V3"/><path d="M20 21v-5"/><path d="M20 12V3"/><path d="M2 14h4"/><path d="M10 8h4"/><path d="M18 16h4"/>',
  server: '<rect width="20" height="8" x="2" y="2" rx="2"/><rect width="20" height="8" x="2" y="14" rx="2"/><path d="M6 6h.01"/><path d="M6 18h.01"/>',
  refresh: '<path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M8 16H3v5"/>',
  globe: '<circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/>',
};

const side = [
  { icon: "bolt", title: "Edge-cached feeds", meta: "Cloudflare KV", body: "Posts are fetched once and cached at the edge, so visitors get fast responses from the nearest data center." },
  { icon: "box", title: "Zero-dependency widget", meta: "Under 6 kB gzipped", body: "One script tag and a custom element. No framework runtime, with Shadow DOM keeping styles isolated." },
  { icon: "sliders", title: "Visual editor", meta: "Live preview", body: "Grid, masonry or showcase. Tune columns, gaps, radius, hover effects and colors and see every change instantly." },
  { icon: "server", title: "Self-hosted", meta: "Your Cloudflare account", body: "Your data, your keys, your domain. Nothing runs on a third-party widget service." },
];

const wide = [
  { icon: "refresh", title: "Automatic sync", meta: "Cron every 6 hours", body: "Cron triggers refresh every feed on a schedule, and you can sync manually from the dashboard any time." },
  { icon: "globe", title: "Works everywhere", meta: "Any HTML page", body: "Plain HTML, WordPress, Shopify, Webflow, React, Vue or Next.js. If it renders HTML, it works." },
];
---

<section id="features">
  <div class="frame">
    <div class="dots-x mx-2"></div>
    <div class="px-4 py-20 text-center sm:py-24">
      <h2 class="section-title mx-auto max-w-lg text-3xl sm:text-4xl">
        Everything you need to embed Instagram, <span class="text-brand-600">nothing you don't.</span>
      </h2>
    </div>
    <div class="dots-x mx-2"></div>

    <div class="grid gap-1 p-1 md:grid-cols-3 md:grid-rows-2">
      {side.slice(0, 2).map((f, i) => (
        <FeatureCard {...f} icon={icons[f.icon]} class={i === 0 ? "md:col-start-1 md:row-start-1" : "md:col-start-3 md:row-start-1"} />
      ))}

      <!-- Statement card -->
      <article class="relative flex flex-col justify-between overflow-hidden rounded-2xl bg-gradient-to-b from-brand-500 to-brand-600 p-7 text-white md:col-start-2 md:row-span-2 md:row-start-1 sm:p-8">
        <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_80%_0%,rgb(255_255_255_/_0.25),transparent_50%)]" aria-hidden="true"></div>
        <div class="relative">
          <span class="inline-flex items-center gap-3 rounded-xl bg-white/15 px-3 py-2 text-sm font-medium ring-1 ring-white/25 shadow-sm">
            <Logo class="size-5" /> <span class="h-4 w-px bg-white/30"></span> Alfsight
          </span>
          <p class="mt-10 text-2xl leading-snug tracking-tight sm:text-[28px]">
            Free and open source, forever. MIT licensed, self-hosted on your own Cloudflare account, with every line of code yours to read and change.
          </p>
        </div>
        <div class="relative mt-10 flex items-center gap-3">
          <span class="flex size-10 items-center justify-center rounded-full bg-white/15 ring-1 ring-white/30">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="size-5"><path d="m16 18 6-6-6-6"></path><path d="m8 6-6 6 6 6"></path></svg>
          </span>
          <span class="leading-tight"><span class="block text-sm font-medium">MIT License</span><span class="text-xs text-white/75">github.com/Manish-Tamang/alfsight</span></span>
        </div>
      </article>

      {side.slice(2).map((f, i) => (
        <FeatureCard {...f} icon={icons[f.icon]} class={i === 0 ? "md:col-start-1 md:row-start-2" : "md:col-start-3 md:row-start-2"} />
      ))}
    </div>

    <div class="grid gap-1 px-1 pb-1 md:grid-cols-2">
      {wide.map((f) => (
        <FeatureCard {...f} icon={icons[f.icon]} size="md" />
      ))}
    </div>
  </div>
</section>
