---
import { Code } from "astro:components";

interface Props {
  code: string;
  lang?: string;
  title?: string;
}

const { code, lang = "bash", title = lang === "bash" ? "terminal" : lang } = Astro.props;
---

<div class="code-block group/code">
  <div class="code-block-header">
    <span class="flex items-center gap-1.5">
      {lang === "bash" && (
        <svg viewBox="0 0 24 24" class="size-3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m4 17 6-6-6-6"></path><path d="M12 19h8"></path>
        </svg>
      )}
      {title}
    </span>
    <button type="button" class="code-copy" data-copy={code} aria-label="Copy code">
      <svg viewBox="0 0 24 24" class="size-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect width="14" height="14" x="8" y="8" rx="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
      </svg>
      <span data-label>Copy</span>
    </button>
  </div>
  <Code code={code} lang={lang as any} theme="github-light" />
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>(".code-copy").forEach((btn) => {
    btn.addEventListener("click", async () => {
      await navigator.clipboard.writeText(btn.dataset.copy ?? "");
      const label = btn.querySelector("[data-label]");
      if (!label) return;
      label.textContent = "Copied";
      setTimeout(() => (label.textContent = "Copy"), 1500);
    });
  });
</script>

<style>
  .code-block {
    margin: 0.75rem 0;
    overflow: hidden;
    border-radius: 12px;
    border: 1px solid #e5e5e5;
    background: #fafafa;
  }
  .code-block-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 6px 8px 6px 14px;
    border-bottom: 1px solid #e5e5e5;
    background: #fff;
    font-family: var(--font-mono);
    font-size: 11px;
    color: #737373;
  }
  .code-copy {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 2px 6px;
    border-radius: 6px;
    font-family: var(--font-sans);
    font-size: 11px;
    color: #737373;
    cursor: pointer;
    transition: background 150ms, color 150ms;
  }
  .code-copy:hover {
    background: #f5f5f5;
    color: #171717;
  }
  .code-block :global(pre) {
    margin: 0;
    padding: 14px;
    overflow-x: auto;
    background: #fafafa !important;
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.65;
  }
  .code-block :global(code) {
    font-family: inherit;
  }
</style>
