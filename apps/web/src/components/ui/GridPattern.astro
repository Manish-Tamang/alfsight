---
// 60px line grid used behind dub.co's hero, faded toward the top and center.
const id = `grid-${Math.random().toString(36).slice(2, 8)}`;
---

<div
  class="pointer-events-none absolute inset-0 overflow-hidden [mask-composite:intersect] [mask-image:linear-gradient(transparent,black),radial-gradient(130%_50%_at_50%_100%,transparent,black)]"
  aria-hidden="true"
>
  <svg class="absolute bottom-0 left-1/2 h-[600px] w-[1080px] -translate-x-1/2 text-[var(--color-grid)]/60">
    <defs>
      <pattern id={id} x="-1" y="0" width="60" height="60" patternUnits="userSpaceOnUse">
        <path d="M 60 0 L 0 0 0 60" fill="transparent" stroke="currentColor" stroke-width="2"></path>
      </pattern>
    </defs>
    <rect fill={`url(#${id})`} width="100%" height="100%"></rect>
  </svg>
</div>
