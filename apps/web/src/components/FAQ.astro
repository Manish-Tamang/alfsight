---
const faqs = [
  {
    q: "Is Alfsight really free?",
    a: "Yes. The code is MIT licensed and runs on your own Cloudflare account. Small and medium sites usually fit within Cloudflare's free tier, so there is no monthly bill to pay.",
  },
  {
    q: "Do I need an Instagram API token or OAuth?",
    a: "No. Public profile data is fetched server-side through the OpenHandle API, so you only need an OpenHandle key (a free test key is available). No Instagram tokens ever reach the browser.",
  },
  {
    q: "Can I show a private Instagram account?",
    a: "No. Alfsight only displays public profiles, the same posts anyone can see on Instagram.",
  },
  {
    q: "How often do new posts appear?",
    a: "A Cloudflare cron trigger re-syncs every feed every 6 hours, and you can trigger a manual sync from the dashboard at any time.",
  },
  {
    q: "Will the widget clash with my site's CSS?",
    a: "No. The widget is a web component rendered in Shadow DOM, so your styles don't leak in and its styles don't leak out.",
  },
  {
    q: "Does it work with WordPress, Shopify or Webflow?",
    a: "Yes. Paste the two-line snippet into any HTML block or custom code embed. If the platform renders HTML, it works.",
  },
];

const icons = [
  '<path d="M12 2v20"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>',
  '<rect width="18" height="11" x="3" y="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>',
  '<path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.53 13.53 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><path d="m2 2 20 20"/>',
  '<path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M8 16H3v5"/>',
  '<path d="M12 3a9 9 0 1 0 9 9"/><path d="M12 3v9h9"/>',
  '<circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/>',
];
---

<section id="faq">
  <div class="frame px-4 pb-20 sm:px-14">
    <h2 class="section-title mx-auto max-w-xl py-20 text-center text-3xl sm:text-4xl">
      Have questions? <span class="hl">Browse the FAQs</span> to find the answers you need.
    </h2>

    <dl class="grid gap-x-14 gap-y-12 px-2 md:grid-cols-2 lg:px-6">
      {faqs.map((f, i) => (
        <div>
          <dt class="flex items-center gap-3 text-base font-medium text-neutral-900">
            <span class="flex size-6 shrink-0 items-center justify-center rounded-md bg-gradient-to-b from-brand-400 to-brand-600 text-white shadow-[inset_0_0_0_1px_rgb(255_255_255_/_0.3)]">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-3.5" set:html={icons[i]} />
            </span>
            {f.q}
          </dt>
          <dd class="mt-4 text-base leading-relaxed text-neutral-600">{f.a}</dd>
        </div>
      ))}
    </dl>

    <p class="mt-16 text-center text-base text-neutral-700">
      Didn't find your answer?{" "}
      <a href="/docs" class="font-medium text-brand-700 hover:underline">Read the docs</a>{" "}
      or{" "}
      <a href="https://github.com/Manish-Tamang/alfsight/issues" target="_blank" rel="noopener noreferrer" class="text-brand-700 underline decoration-brand-200 underline-offset-2 hover:decoration-brand-600">open an issue on GitHub</a>.
    </p>
  </div>
</section>
