---
const platforms = ["HTML", "WordPress", "Shopify", "Webflow", "Squarespace", "Wix", "React", "Next.js", "Vue", "Astro"];
const stats = [
  { value: "< 3 kB", label: "gzipped widget" },
  { value: "0", label: "runtime dependencies" },
  { value: "6 h", label: "automatic re-sync" },
  { value: "MIT", label: "licensed, forever free" },
];
---

<section class="grid-section">
  <div class="grid-col">
    <div class="px-4 py-10 text-center">
      <p class="text-sm text-neutral-500">Works anywhere that renders HTML</p>
      <div class="mx-auto mt-5 flex max-w-4xl flex-wrap justify-center gap-2">
        {platforms.map((p) => (
          <span class="rounded-full border border-neutral-200 bg-white px-3 py-1 text-sm font-medium text-neutral-600 shadow-[0_1px_2px_rgb(0_0_0_/_0.04)]">
            {p}
          </span>
        ))}
      </div>
    </div>

    <div class="grid grid-cols-2 gap-px border-t border-[var(--color-grid)] bg-[var(--color-grid)] lg:grid-cols-4">
      {stats.map((s) => (
        <div class="bg-white px-6 py-8 text-center">
          <p class="font-display text-3xl font-medium text-neutral-900 sm:text-4xl">{s.value}</p>
          <p class="mt-1 text-sm text-neutral-500">{s.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
