---
import GitHubIcon from "./ui/GitHubIcon.astro";
---

<section class="grid-section">
  <div class="grid-col px-4 py-12 sm:px-10 sm:py-16">
    <div class="relative overflow-hidden rounded-2xl bg-brand-500 px-6 py-14 text-center sm:px-12 sm:py-16">
      <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_20%_0%,rgb(255_255_255_/_0.25),transparent_45%),radial-gradient(circle_at_90%_100%,rgb(0_0_0_/_0.12),transparent_50%)]" aria-hidden="true"></div>
      <img src="/alfsight.png" alt="" class="relative mx-auto size-12 rounded-xl ring-4 ring-white/30" />
      <h2 class="relative mt-6 font-display text-3xl font-medium text-white sm:text-4xl">
        Ship your Instagram feed today
      </h2>
      <p class="relative mx-auto mt-3 max-w-md text-base text-white/85">
        Fork the repo, deploy to Cloudflare and embed your first widget in minutes.
      </p>
      <div class="relative mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <a href="/docs" class="btn border-white bg-white text-neutral-900 hover:bg-neutral-50 hover:!shadow-[0_0_0_4px_rgb(255_255_255_/_0.3)]">
          Read the docs
        </a>
        <a
          href="https://github.com/Manish-Tamang/alfsight"
          target="_blank"
          rel="noopener noreferrer"
          class="btn border-white/40 bg-white/10 text-white hover:bg-white/20 hover:!shadow-[0_0_0_4px_rgb(255_255_255_/_0.2)]"
        >
          <GitHubIcon class="size-4" />
          Star on GitHub
        </a>
      </div>
    </div>
  </div>
</section>
