---
import GitHubIcon from "./ui/GitHubIcon.astro";

const tiles = ["from-amber-100 to-orange-200", "from-emerald-100 to-teal-200", "from-sky-100 to-indigo-200", "from-rose-100 to-pink-200", "from-lime-100 to-green-300", "from-violet-100 to-fuchsia-200"];
---

<section>
  <div class="frame">
    <div class="dots-x mx-2"></div>
    <div class="relative grid min-h-[380px] grid-cols-1 lg:grid-cols-[1fr_minmax(0,440px)_1fr]">
      <!-- Left collage -->
      <div class="relative hidden overflow-hidden lg:block" aria-hidden="true">
        <div class="absolute inset-y-6 left-10 right-4 grid grid-cols-2 grid-rows-[repeat(2,120px)] content-center gap-3 opacity-60 [mask-image:linear-gradient(to_right,transparent,black_40%)]">
          <div class="row-span-2 rounded-xl bg-white p-3 ring-1 ring-black/5">
            <div class="h-2 w-24 rounded bg-neutral-200"></div>
            <div class="mt-3 grid grid-cols-3 gap-1.5">
              {tiles.map((t) => <div class={`aspect-square rounded bg-gradient-to-br ${t}`}></div>)}
            </div>
            <div class="mt-3 h-2 w-16 rounded bg-neutral-100"></div>
          </div>
          <div class="rounded-xl bg-white p-3 ring-1 ring-black/5"><div class="h-2 w-12 rounded bg-neutral-200"></div><div class="mt-2 h-8 rounded bg-neutral-100"></div></div>
          <div class="rounded-xl bg-white p-3 ring-1 ring-black/5"><div class="h-2 w-16 rounded bg-brand-200"></div><div class="mt-2 h-8 rounded bg-neutral-100"></div></div>
        </div>
        <div class="dots-y absolute inset-y-0 right-0"></div>
      </div>

      <div class="flex flex-col items-center justify-center px-6 py-16 text-center">
        <h2 class="section-title text-3xl sm:text-[32px] sm:leading-tight">
          Let's get your feed <span class="hl">live on your site</span> in minutes.
        </h2>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="/docs" class="btn btn-primary">Read the docs</a>
          <a href="https://github.com/Manish-Tamang/alfsight" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
            <GitHubIcon class="size-4" /> Star on GitHub
          </a>
        </div>
      </div>

      <!-- Right collage -->
      <div class="relative hidden overflow-hidden lg:block" aria-hidden="true">
        <div class="dots-y absolute inset-y-0 left-0"></div>
        <div class="absolute inset-y-6 left-4 right-10 grid grid-cols-2 grid-rows-[repeat(2,120px)] content-center gap-3 opacity-60 [mask-image:linear-gradient(to_left,transparent,black_40%)]">
          <div class="rounded-xl bg-white p-3 ring-1 ring-black/5"><div class="h-2 w-14 rounded bg-neutral-200"></div><div class="mt-2 flex gap-1"><span class="h-4 flex-1 rounded bg-neutral-100"></span><span class="h-4 flex-1 rounded bg-white ring-1 ring-neutral-200"></span></div></div>
          <div class="row-span-2 rounded-xl bg-white p-3 ring-1 ring-black/5">
            <div class="mx-auto size-8 rounded-full bg-gradient-to-tr from-amber-300 via-rose-400 to-fuchsia-500"></div>
            <div class="mx-auto mt-2 h-2 w-16 rounded bg-neutral-200"></div>
            <div class="mt-3 grid grid-cols-2 gap-1.5">
              {tiles.slice(0, 4).map((t) => <div class={`aspect-square rounded bg-gradient-to-br ${t}`}></div>)}
            </div>
          </div>
          <div class="rounded-xl bg-white p-3 ring-1 ring-black/5"><div class="h-2 w-10 rounded bg-brand-200"></div><div class="mt-2 h-8 rounded bg-neutral-100"></div></div>
        </div>
      </div>
    </div>
    <div class="dots-x mx-2"></div>
  </div>
</section>
