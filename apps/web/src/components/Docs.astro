---
import { DASHBOARD_URL } from "@/lib/site";

const endpoints = [
  { method: "GET", path: "/api/feeds/:id", description: "Fetch feed metadata and posts (cached via KV)" },
  { method: "POST", path: "/api/feeds", description: "Create a new feed configuration" },
  { method: "PATCH", path: "/api/feeds/:id", description: "Update feed settings" },
  { method: "DELETE", path: "/api/feeds/:id", description: "Remove a feed" },
  { method: "POST", path: "/api/feeds/:id/refresh", description: "Trigger manual feed sync" },
];
---

<section id="docs" class="grid-section">
  <div class="grid-col px-4 pb-16 sm:pb-20">
    <div class="py-16 text-center sm:py-20">
      <h2 class="font-display text-3xl font-medium text-neutral-900 sm:text-4xl">API reference</h2>
      <p class="mx-auto mt-3 max-w-md text-base text-neutral-500 sm:text-lg">
        A minimal REST API for managing feeds. Authenticated routes use a dev header locally.
      </p>
    </div>

    <div class="mx-auto max-w-2xl overflow-hidden rounded-xl border border-neutral-200 bg-white shadow-sm">
      <div class="border-b border-neutral-200 bg-neutral-50 px-4 py-2.5 text-xs font-medium text-neutral-500">
        Endpoints
      </div>
      {endpoints.map((ep, i) => (
        <div class:list={[
          "flex items-start gap-3 px-4 py-3 text-sm",
          i < endpoints.length - 1 && "border-b border-neutral-200",
        ]}>
          <span class:list={[
            "inline-flex h-5 w-14 shrink-0 items-center justify-center rounded-md border font-mono text-[10px] font-medium",
            ep.method === "GET" && "border-green-200 bg-green-50 text-green-700",
            ep.method === "POST" && "border-blue-200 bg-blue-50 text-blue-700",
            ep.method === "PATCH" && "border-amber-200 bg-amber-50 text-amber-700",
            ep.method === "DELETE" && "border-red-200 bg-red-50 text-red-700",
          ]}>
            {ep.method}
          </span>
          <div>
            <code class="font-mono text-[13px] text-neutral-900">{ep.path}</code>
            <p class="mt-0.5 text-[13px] text-neutral-500">{ep.description}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-10 flex justify-center gap-4">
      <a href="/docs" class="btn btn-primary">Read the docs</a>
      <a href={DASHBOARD_URL} class="btn btn-secondary">Open dashboard</a>
    </div>
  </div>
</section>
