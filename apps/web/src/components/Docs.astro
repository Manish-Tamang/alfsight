---
const endpoints = [
  { method: "GET", path: "/api/feeds/:id", description: "Fetch feed metadata and posts (cached via KV)" },
  { method: "POST", path: "/api/feeds", description: "Create a new feed configuration" },
  { method: "PATCH", path: "/api/feeds/:id", description: "Update feed settings" },
  { method: "DELETE", path: "/api/feeds/:id", description: "Remove a feed" },
  { method: "POST", path: "/api/feeds/:id/refresh", description: "Trigger manual feed sync" },
];
---

<section id="docs" class="border-t border-[var(--color-border-soft)] py-20 sm:py-28">
  <div class="mx-auto max-w-5xl px-6">
    <div class="text-center">
      <h2 class="text-[28px] font-bold tracking-tight text-[var(--color-text)]">API reference</h2>
      <p class="mx-auto mt-3 max-w-md text-[15px] text-[var(--color-text-muted)]">
        A minimal REST API for managing feeds. Authenticated routes use a dev header locally.
      </p>
    </div>

    <div class="mx-auto mt-10 max-w-2xl overflow-hidden rounded border border-[var(--color-border)] bg-[var(--color-surface)]">
      <div class="border-b border-[var(--color-border-soft)] px-4 py-2.5 text-[11px] font-semibold uppercase tracking-wide text-[var(--color-text-soft)]">
        Endpoints
      </div>
      {endpoints.map((ep, i) => (
        <div class:list={[
          "flex items-start gap-3 px-4 py-3 text-[13px]",
          i < endpoints.length - 1 && "border-b border-[var(--color-border-soft)]",
        ]}>
          <span class:list={[
            "inline-flex h-5 shrink-0 items-center rounded px-1.5 text-[10px] font-bold",
            ep.method === "GET" && "bg-emerald-50 text-emerald-700",
            ep.method === "POST" && "bg-blue-50 text-blue-700",
            ep.method === "PATCH" && "bg-amber-50 text-amber-700",
            ep.method === "DELETE" && "bg-red-50 text-red-700",
          ]}>
            {ep.method}
          </span>
          <div>
            <code class="text-[12px] font-semibold text-[var(--color-text)]">{ep.path}</code>
            <p class="mt-0.5 text-[12px] text-[var(--color-text-muted)]">{ep.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
