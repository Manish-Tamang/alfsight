---
// Mock of an embedded feed: colored tiles stand in for real posts.
const tiles = [
  "from-amber-200 to-orange-400",
  "from-emerald-200 to-teal-500",
  "from-sky-200 to-indigo-400",
  "from-rose-200 to-pink-400",
  "from-lime-200 to-green-500",
  "from-violet-200 to-fuchsia-400",
  "from-stone-200 to-stone-400",
  "from-cyan-200 to-sky-500",
];
const badges: Record<number, "video" | "carousel"> = { 1: "video", 4: "carousel", 6: "video" };
---

<section class="grid-section bg-neutral-100">
  <div class="grid-col px-4 py-12 sm:px-10 sm:py-16">
    <div class="relative mx-auto max-w-4xl animate-slide-up-fade [animation-delay:450ms]">
      <!-- Browser frame -->
      <div class="overflow-hidden rounded-2xl border border-neutral-200 bg-white shadow-[0_24px_48px_-24px_rgb(0_0_0_/_0.18)]">
        <div class="flex items-center gap-3 border-b border-neutral-200 bg-neutral-50 px-4 py-2.5">
          <div class="flex gap-1.5">
            <span class="size-2.5 rounded-full bg-neutral-300"></span>
            <span class="size-2.5 rounded-full bg-neutral-300"></span>
            <span class="size-2.5 rounded-full bg-neutral-300"></span>
          </div>
          <div class="mx-auto flex h-6 w-full max-w-xs items-center justify-center gap-1.5 rounded-md border border-neutral-200 bg-white text-[11px] text-neutral-500">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-3" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path></svg>
            yourbrand.com
          </div>
          <div class="w-10"></div>
        </div>

        <div class="p-5 sm:p-8">
          <!-- Widget header -->
          <div class="flex flex-wrap items-center gap-4">
            <div class="rounded-full bg-gradient-to-tr from-amber-400 via-rose-500 to-fuchsia-600 p-[2px]">
              <div class="flex size-12 items-center justify-center rounded-full bg-white font-display text-sm font-bold text-neutral-800 sm:size-14">
                YB
              </div>
            </div>
            <div class="min-w-0">
              <p class="text-sm font-semibold text-neutral-900 sm:text-base">Your Brand</p>
              <p class="text-xs text-neutral-500">@yourbrand</p>
            </div>
            <div class="hidden gap-5 text-center sm:flex">
              <div><p class="text-sm font-semibold text-neutral-900">248</p><p class="text-[11px] text-neutral-500">posts</p></div>
              <div><p class="text-sm font-semibold text-neutral-900">12.4k</p><p class="text-[11px] text-neutral-500">followers</p></div>
              <div><p class="text-sm font-semibold text-neutral-900">311</p><p class="text-[11px] text-neutral-500">following</p></div>
            </div>
            <span class="ml-auto inline-flex h-8 items-center rounded-lg bg-brand-500 px-4 text-xs font-semibold text-white">Follow</span>
          </div>

          <!-- Post grid -->
          <div class="mt-5 grid grid-cols-3 gap-1.5 sm:grid-cols-4 sm:gap-3">
            {tiles.map((t, i) => (
              <div class:list={["group relative aspect-square overflow-hidden rounded-lg bg-gradient-to-br", t, i >= 6 && "max-sm:hidden"]}>
                <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_25%,rgb(255_255_255_/_0.55),transparent_55%)]"></div>
                {badges[i] === "video" && (
                  <svg viewBox="0 0 24 24" fill="white" class="absolute right-2 top-2 size-4 drop-shadow" aria-hidden="true"><path d="M8 5v14l11-7z"></path></svg>
                )}
                {badges[i] === "carousel" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" class="absolute right-2 top-2 size-4 drop-shadow" aria-hidden="true"><rect x="7" y="7" width="13" height="13" rx="2"></rect><path d="M4 16V6a2 2 0 0 1 2-2h10"></path></svg>
                )}
                <div class="absolute inset-0 flex items-center justify-center gap-3 bg-black/40 text-xs font-semibold text-white opacity-0 transition-opacity group-hover:opacity-100">
                  <span>&#9829; {(i + 3) * 137}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Floating embed snippet -->
      <div class="relative mx-auto -mt-6 w-[calc(100%-2rem)] max-w-md overflow-hidden rounded-xl border border-neutral-200 bg-white shadow-[0_16px_32px_-12px_rgb(0_0_0_/_0.2)] lg:absolute lg:-bottom-8 lg:-right-10 lg:mt-0 lg:w-[380px]">
        <div class="flex items-center justify-between border-b border-neutral-200 px-3.5 py-2">
          <span class="font-mono text-[11px] text-neutral-500">index.html</span>
          <span class="rounded-full bg-brand-50 px-2 py-0.5 text-[10px] font-medium text-brand-700">2 lines</span>
        </div>
        <pre class="overflow-x-auto p-3.5 font-mono text-[11.5px] leading-relaxed"><code class="text-neutral-800"><span class="text-rose-600">&lt;script</span> <span class="text-blue-600">src</span>=<span class="text-emerald-700">"…/instagram.js"</span> <span class="text-blue-600">defer</span><span class="text-rose-600">&gt;&lt;/script&gt;</span>
<span class="text-rose-600">&lt;instagram-feed</span> <span class="text-blue-600">feed</span>=<span class="text-emerald-700">"YOUR_FEED_ID"</span><span class="text-rose-600">&gt;&lt;/instagram-feed&gt;</span></code></pre>
      </div>
    </div>
  </div>
</section>
