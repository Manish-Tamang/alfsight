---
import { Code } from "astro:components";
import { API_BASE, DEMO_FEED_ID, WIDGET_URL } from "@/lib/site";

const snippet = `<instagram-feed feed="${DEMO_FEED_ID}" api-base="${API_BASE}"></instagram-feed>
<script src="${WIDGET_URL}/instagram.iife.js" defer></script>`;
---

<section id="preview">
  <div class="frame px-4 py-20 sm:px-10 sm:py-24">
    <h2 class="section-title mx-auto max-w-xl text-center text-3xl sm:text-4xl">
      Your Instagram feed, <span class="text-brand-600">embedded in two lines</span> of code.
    </h2>
    <p class="mx-auto mt-4 max-w-md text-center text-base text-neutral-500">
      This is a live Alfsight widget, loaded from our own Cloudflare deployment.
    </p>

    <div class="mx-auto mt-12 max-w-4xl overflow-hidden rounded-[4px] bg-white shadow-xl shadow-black/[0.06] ring-1 ring-black/10">
      <!-- Browser chrome -->
      <div class="flex items-center gap-3 border-b border-neutral-200 bg-neutral-50 px-4 py-2.5">
        <div class="flex gap-1.5">
          <span class="size-3 rounded-full bg-[#FF5F57] ring-1 ring-inset ring-black/10"></span>
          <span class="size-3 rounded-full bg-[#FEBC2E] ring-1 ring-inset ring-black/10"></span>
          <span class="size-3 rounded-full bg-[#28C840] ring-1 ring-inset ring-black/10"></span>
        </div>
        <div class="mx-auto flex h-6 w-full max-w-xs items-center justify-center gap-1.5 rounded-[4px] border border-neutral-200 bg-white text-[11px] text-neutral-500">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-3" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path></svg>
          gole.codes
        </div>
        <span class="flex w-10 items-center justify-end gap-1 text-[11px] text-neutral-500"><span class="size-1.5 rounded-full bg-brand-500"></span>Live</span>
      </div>

      <!-- Live widget -->
      <div class="min-h-[240px] p-4 sm:min-h-[420px] sm:p-8">
        <instagram-feed feed={DEMO_FEED_ID} api-base={API_BASE}></instagram-feed>
      </div>

      <!-- The exact snippet rendering the widget above -->
      <div class="embed border-t border-neutral-200 bg-neutral-50/70">
        <div class="flex items-center justify-between gap-3 px-4 py-3 sm:px-5">
          <div class="flex min-w-0 items-center gap-3">
            <span class="flex size-8 shrink-0 items-center justify-center rounded-[4px] bg-brand-50 text-brand-700 ring-1 ring-brand-200">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4" aria-hidden="true"><path d="m16 18 6-6-6-6"></path><path d="m8 6-6 6 6 6"></path></svg>
            </span>
            <div class="min-w-0 leading-tight">
              <p class="text-sm font-medium text-neutral-900">Embed code</p>
              <p class="truncate text-xs text-neutral-500">Paste anywhere in your page's HTML</p>
            </div>
          </div>
          <button type="button" class="btn btn-secondary !h-8 !rounded-[4px] !px-3 text-sm" data-copy-embed={snippet}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-3.5" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg>
            <span data-label>Copy</span>
          </button>
        </div>
        <div class="mx-4 mb-4 overflow-hidden rounded-[4px] bg-white ring-1 ring-neutral-200 sm:mx-5 sm:mb-5">
          <Code code={snippet} lang="html" theme="github-light" />
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline defer src={`${WIDGET_URL}/instagram.iife.js`}></script>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-copy-embed]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      await navigator.clipboard.writeText(btn.dataset.copyEmbed ?? "");
      const label = btn.querySelector("[data-label]");
      if (!label) return;
      label.textContent = "Copied";
      setTimeout(() => (label.textContent = "Copy"), 1500);
    });
  });
</script>

<style>
  /* Line-numbered snippet */
  .embed :global(pre) {
    margin: 0;
    padding: 12px 0;
    overflow-x: auto;
    background: #fff !important;
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.75;
    counter-reset: line;
  }
  .embed :global(code) {
    font-family: inherit;
  }
  .embed :global(.line) {
    display: inline-block;
    padding-right: 16px;
  }
  .embed :global(.line)::before {
    counter-increment: line;
    content: counter(line);
    display: inline-block;
    width: 2.75rem;
    padding-right: 1rem;
    text-align: right;
    color: #a3a3a3;
    user-select: none;
  }
</style>
