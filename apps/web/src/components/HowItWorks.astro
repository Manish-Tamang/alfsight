---
const steps = [
  {
    step: "1",
    title: "Create a widget",
    description: "Open the dashboard, enter an Instagram username, and configure the layout — grid, masonry, or showcase.",
  },
  {
    step: "2",
    title: "Customize the design",
    description: "Adjust columns, gap, border radius, background color, hover effects, and card style in the visual editor.",
  },
  {
    step: "3",
    title: "Embed anywhere",
    description: "Copy the two-line snippet and paste it into any HTML page. The widget loads in under 6 kB.",
  },
];
---

<section id="how-it-works" class="grid-section bg-neutral-100">
  <div class="grid-col bg-white">
    <div class="px-4 py-16 text-center sm:py-20">
      <h2 class="font-display text-3xl font-medium text-neutral-900 sm:text-4xl">Three steps to a live feed</h2>
      <p class="mx-auto mt-3 max-w-md text-base text-neutral-500 sm:text-lg">
        No OAuth tokens, no API keys in the browser, no framework lock-in.
      </p>
    </div>

    <div class="grid border-t border-[var(--color-grid)] sm:grid-cols-3 sm:divide-x divide-[var(--color-grid)] max-sm:divide-y">
      {steps.map((item) => (
        <div class="p-8">
          <div class="mb-4 flex size-7 items-center justify-center rounded-full border border-brand-200 bg-brand-50 font-mono text-xs font-medium text-brand-700">
            {item.step}
          </div>
          <h3 class="text-base font-medium text-neutral-900">{item.title}</h3>
          <p class="mt-1.5 text-sm leading-relaxed text-neutral-500">{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
