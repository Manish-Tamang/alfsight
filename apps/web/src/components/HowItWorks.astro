---
const steps = [
  {
    step: "1",
    title: "Create a widget",
    description: "Open the dashboard, enter an Instagram username, and configure the layout — grid, masonry, or showcase.",
  },
  {
    step: "2",
    title: "Customize the design",
    description: "Adjust columns, gap, border radius, background color, hover effects, and card style in the visual editor.",
  },
  {
    step: "3",
    title: "Embed anywhere",
    description: "Copy the two-line snippet and paste it into any HTML page. The widget loads in under 3 kB.",
  },
];
---

<section id="how-it-works" class="border-t border-[var(--color-border-soft)] py-20 sm:py-28">
  <div class="mx-auto max-w-5xl px-6">
    <div class="text-center">
      <h2 class="text-[28px] font-bold tracking-tight text-[var(--color-text)]">Three steps to a live feed</h2>
      <p class="mx-auto mt-3 max-w-md text-[15px] text-[var(--color-text-muted)]">
        No OAuth tokens, no API keys in the browser, no framework lock-in.
      </p>
    </div>

    <div class="mt-14 grid gap-8 sm:grid-cols-3">
      {steps.map((item) => (
        <div class="text-center">
          <div class="mx-auto mb-4 flex h-10 w-10 items-center justify-center rounded-full bg-gradient-to-b from-[var(--color-primary)] to-[var(--color-primary-hover)] text-[15px] font-bold text-white shadow-[inset_0_4px_3px_-2px_var(--color-primary-glow),0_4px_5px_-3px_rgba(0,0,0,0.4)]">
            {item.step}
          </div>
          <h3 class="text-[15px] font-semibold text-[var(--color-text)]">{item.title}</h3>
          <p class="mt-2 text-[13px] leading-relaxed text-[var(--color-text-muted)]">{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
