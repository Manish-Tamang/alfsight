---
import GitHubIcon from "./ui/GitHubIcon.astro";
import BrandIcon from "./ui/BrandIcon.astro";

const platforms = [
  { name: "WordPress", kind: "CMS", icon: "wordpress", color: "text-[#21759B]" },
  { name: "Shopify", kind: "E-commerce", icon: "shopify", color: "text-[#7AB55C]" },
  { name: "Webflow", kind: "No-code", icon: "webflow", color: "text-[#146EF5]" },
  { name: "Next.js", kind: "Framework", icon: "nextjs", color: "text-black" },
] as const;
---

<section class="relative overflow-hidden">
  <!-- Soft brand sky that fades into the page -->
  <div class="pointer-events-none absolute inset-x-0 top-0 h-[560px]" aria-hidden="true">
    <div class="absolute inset-0 bg-[radial-gradient(80%_70%_at_50%_0%,var(--color-brand-100),transparent_70%),radial-gradient(40%_50%_at_15%_10%,rgb(186_230_253_/_0.6),transparent_70%),radial-gradient(40%_50%_at_85%_5%,rgb(167_243_208_/_0.7),transparent_70%)]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgb(15_134_58_/_0.18)_1px,transparent_1.5px)] bg-[length:18px_18px] [mask-image:linear-gradient(to_bottom,black,transparent_85%)]"></div>
  </div>

  <div class="frame px-4 pt-36 pb-14 sm:pt-44">
    <div class="relative mx-auto max-w-3xl text-center">
      <h1 class="section-title animate-slide-up-fade text-4xl leading-[1.15] [--offset:20px] sm:text-5xl md:text-6xl">
        The open-source <span class="hl">alternative to Elfsight</span>
      </h1>
      <p class="mx-auto mt-6 max-w-xl animate-slide-up-fade text-base leading-relaxed text-neutral-700 [animation-delay:100ms] sm:text-lg">
        Alfsight is a self-hosted Instagram feed widget. Embed beautiful, fast feeds on any website with one script tag. No subscription and no view limits.
      </p>

      <div class="mt-8 flex animate-slide-up-fade flex-col justify-center gap-3 [animation-delay:200ms] sm:flex-row sm:gap-4">
        <a href="/docs" class="btn btn-primary">
          Get started
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
        </a>
        <a href="https://github.com/Manish-Tamang/alfsight" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
          <GitHubIcon class="size-4" />
          Star on GitHub
        </a>
      </div>
    </div>

    <div class="relative mt-16 animate-slide-up-fade text-center [animation-delay:300ms]">
      <p class="text-sm font-medium text-neutral-800">Works anywhere that<br />renders HTML</p>
      <ul class="mx-auto mt-5 grid max-w-2xl grid-cols-2 gap-x-6 gap-y-5 sm:grid-cols-4">
        {platforms.map((p) => (
          <li class="flex items-center justify-center gap-3 sm:justify-start">
            <span class={`flex size-9 shrink-0 items-center justify-center rounded-lg bg-white ring-1 ring-black/10 shadow-sm ${p.color}`}>
              <BrandIcon name={p.icon} class="size-5" />
            </span>
            <span class="text-left leading-tight">
              <span class="block text-[15px] text-neutral-800">{p.name}</span>
              <span class="block text-xs text-neutral-500">{p.kind}</span>
            </span>
          </li>
        ))}
      </ul>
    </div>
  </div>
  <div class="frame"><div class="dots-x mx-2"></div></div>
</section>
