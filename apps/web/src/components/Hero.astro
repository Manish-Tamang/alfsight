---
import GridPattern from "./ui/GridPattern.astro";
import GitHubIcon from "./ui/GitHubIcon.astro";
---

<section class="grid-section !border-t-0">
  <div class="grid-col overflow-hidden px-4 pt-28 pb-16 sm:pt-36 sm:pb-24">
    <GridPattern />
    <div
      class="pointer-events-none absolute left-1/2 top-24 h-64 w-[640px] -translate-x-1/2 rounded-full bg-brand-500/10 blur-3xl"
      aria-hidden="true"
    ></div>

    <div class="relative mx-auto flex max-w-2xl flex-col items-center text-center">
      <a
        href="https://github.com/Manish-Tamang/alfsight"
        target="_blank"
        rel="noopener noreferrer"
        class="group flex animate-slide-up-fade items-center rounded-full border border-neutral-300 bg-white text-xs font-medium drop-shadow-sm transition-colors hover:bg-neutral-50 sm:divide-x sm:divide-neutral-300 [--offset:10px]"
      >
        <span class="flex items-center gap-1.5 py-1.5 pl-3 text-neutral-800 sm:pr-2.5">
          <span class="relative flex size-2">
            <span class="absolute inline-flex size-full animate-ping rounded-full bg-brand-500 opacity-60"></span>
            <span class="relative inline-flex size-2 rounded-full bg-brand-500"></span>
          </span>
          MIT licensed &middot; Self-hosted on Cloudflare
        </span>
        <span class="flex items-center gap-1.5 p-1.5 pl-2.5 text-neutral-500">
          <span class="hidden sm:block">Star on GitHub</span>
          <span class="rounded-full bg-brand-50 p-0.5 text-brand-700">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" class="size-2.5 transition-transform group-hover:-translate-y-px group-hover:translate-x-px">
              <path d="M7 7h10v10"></path><path d="M7 17 17 7"></path>
            </svg>
          </span>
        </span>
      </a>

      <h1 class="mt-5 animate-slide-up-fade text-pretty font-display text-4xl font-medium text-neutral-900 [--offset:20px] [animation-delay:100ms] sm:text-6xl sm:leading-[1.1]">
        The open-source alternative to{" "}
        <span class="bg-gradient-to-r from-brand-600 to-brand-500 bg-clip-text text-transparent">Elfsight</span>
      </h1>

      <p class="mt-5 max-w-xl animate-slide-up-fade text-pretty text-base text-neutral-600 [animation-delay:200ms] sm:text-xl">
        Self-hosted Instagram feed widgets for any website. No subscription and no view limits, just one script tag.
      </p>
    </div>

    <div class="relative mx-auto mt-10 flex max-w-fit animate-slide-up-fade flex-col gap-3 [--offset:5px] [animation-delay:300ms] sm:flex-row sm:gap-4">
      <a href="/docs" class="btn btn-primary group">
        Get started
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true">
          <path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>
      <a href="https://github.com/Manish-Tamang/alfsight" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
        <GitHubIcon class="size-4" />
        Star on GitHub
      </a>
    </div>

    <p class="relative mt-6 animate-slide-up-fade text-center text-xs text-neutral-500 [animation-delay:400ms]">
      Free forever &middot; Under 3&nbsp;kB gzipped &middot; Deploys in minutes
    </p>
  </div>
</section>
