---
import Logo from "./ui/Logo.astro";
import GitHubIcon from "./ui/GitHubIcon.astro";

interface Props {
  links?: { label: string; href: string; active?: boolean }[];
}

const {
  links = [
    { label: "Features", href: "/#features" },
    { label: "How it works", href: "/#how-it-works" },
    { label: "Compare", href: "/#compare" },
    { label: "FAQ", href: "/#faq" },
    { label: "Docs", href: "/docs" },
  ],
} = Astro.props;
---

<nav class="sticky top-0 z-50 w-full border-b border-transparent bg-white/75 backdrop-blur-lg transition-colors" data-navbar>
  <div class="mx-auto flex h-14 w-full max-w-[1080px] items-center justify-between px-4 xl:px-0">
    <div class="flex grow basis-0 items-center">
      <a href="/" class="flex items-center gap-2 py-2 pr-2 text-black">
        <Logo class="h-6 w-6" />
        <span class="font-display text-[17px] font-bold tracking-tight">Alfsight</span>
      </a>
    </div>

    <div class="hidden items-center sm:flex">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={[
            "flex h-8 items-center rounded-lg px-3 text-sm font-medium text-neutral-700 transition-colors hover:bg-neutral-900/5 hover:text-neutral-900",
            link.active && "bg-neutral-900/5 text-neutral-900",
          ]}
        >
          {link.label}
        </a>
      ))}
    </div>

    <div class="flex grow basis-0 items-center justify-end gap-2">
      <a
        href="https://github.com/Manish-Tamang/alfsight"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden h-8 items-center gap-1.5 rounded-lg px-3 text-sm font-medium text-neutral-700 transition-colors hover:bg-neutral-900/5 hover:text-neutral-900 md:flex"
        aria-label="Alfsight on GitHub"
      >
        <GitHubIcon class="size-4" />
        GitHub
      </a>
      <a href="/dashboard" class="btn btn-primary btn-sm">Dashboard</a>
    </div>
  </div>
</nav>

<script>
  const nav = document.querySelector<HTMLElement>("[data-navbar]");
  const onScroll = () => nav?.classList.toggle("!border-neutral-200", window.scrollY > 8);
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });
</script>
