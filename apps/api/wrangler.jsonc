{
  // Alfsight API — Cloudflare Worker
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "instagram-widget-api",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-25",

  // Keep the custom domain attached on every deploy (also keeps *.workers.dev).
  // The hostname must not have another DNS record, e.g. an old Vercel CNAME.
  "routes": [{ "pattern": "api.manishtamang.com", "custom_domain": true }],
  "workers_dev": true,

  // D1 Database
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "instagram-widget-db",
      "database_id": "4b4fb570-07fd-4f9c-82a2-e7df8be0b7fa",
      "migrations_dir": "../../database/migrations",
    },
  ],

  // KV Namespace for feed caching
  "kv_namespaces": [
    {
      "binding": "FEED_CACHE",
      "id": "f4245a4642f44ce28d1584b1a87a77d5",
    },
  ],

  // Cron triggers for scheduled feed refresh
  "triggers": {
    "crons": [
      "0 */6 * * *", // Every 6 hours
    ],
  },

  // Environment variables (non-secret).
  // Local dev overrides this with ENVIRONMENT=development in .dev.vars.
  "vars": {
    "ENVIRONMENT": "production",
  },

  // Secrets (set via `wrangler secret put`):
  // - ADMIN_TOKEN: the dashboard sign-in token in production
  // - OPENHANDLE_TEST_KEY for local/test data
  // - OPENHANDLE_LIVE_KEY for explicitly enabled production access
}
